# Konfiguracja pod hosting Apache/LiteSpeed (Hostinger). Plik działa po wgraniu do katalogu głównego domeny (public_html).

# --- HTTPS ---------------------------------------------------------------
# Odkomentuj DOPIERO, gdy certyfikat SSL jest aktywny (hPanel → SSL), inaczej strona przestanie się otwierać.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Strona błędu 404 ----------------------------------------------------
ErrorDocument 404 /404.html

# --- Kodowanie i typy ----------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# --- Kompresja -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json application/xml image/svg+xml text/plain
</IfModule>

# --- Cache przeglądarki --------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # CSS i JS: linki w HTML mają ?v=<hash> (scripts/bump-version.sh), więc nowy HTML zawsze pobiera nowe pliki
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
</IfModule>

# --- Nagłówki bezpieczeństwa --------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Przyjazne URL -------------------------------------------------------
Options -Indexes
DirectoryIndex index.html
